{"manifest_version":1,"notes":"Every business mutation OPE performs must map to one entry here with an exact method, path, request/response schemas, security scheme, and reconciliation operation. verify-contract.sh checks each entry against the vendored OpenAPI in contracts/authscope-v1.yaml. Missing entries fail the contract-ready gate; OPE must not emulate them locally.","required_operations":[{"capability":"discover_authority","method":"GET","notes":"Unauthenticated discovery of API versions and the mission-authority document.","path":"/.well-known/mission-authority","reconcile_path":"","request_schema":"","response_schema":"GenericObject","security_scheme":"none"},{"capability":"verify_workspace_identity","method":"POST","notes":"AuthScope verifies the mTLS/workload-signer identity is restricted to the instance workspace and carries the decision_attestor role. AuthScope derives identity from authenticated transport; OPE never selects it via header.","path":"/v1/identities/workload/verify","reconcile_path":"","request_schema":"VerifyWorkloadIdentityRequest","response_schema":"WorkspaceIdentity","security_scheme":"workload_identity_mtls"},{"capability":"register_workload_identity","method":"POST","notes":"One-time registration of the workspace-bound OPE workload identity with the decision_attestor role.","path":"/v1/identities/workload/register","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"RegisterWorkloadIdentityRequest","response_schema":"WorkspaceIdentity","security_scheme":"workload_identity_mtls"},{"capability":"verify_decision_attestation","method":"POST","notes":"AuthScope independently verifies attestation signature, workspace, audience, decision digest, invocation digest, authentication method and proof digest, nonce, freshness, and one-use replay state.","path":"/v1/decision-attestations/verify","reconcile_path":"","request_schema":"DecisionAttestation","response_schema":"DecisionAttestationVerdict","security_scheme":"workload_identity_mtls"},{"capability":"shape_mission","method":"POST","notes":"Dry-run shaping of a mission from an issue snapshot and template limits; returns canonical digests without creating a proposal.","path":"/v1/mission-proposals/shape","reconcile_path":"","request_schema":"ShapeMissionRequest","response_schema":"MissionDraft","security_scheme":"workload_identity_mtls"},{"capability":"create_proposal","method":"POST","notes":"Creates an AuthScope proposal; idempotent on the OPE-supplied key.","path":"/v1/mission-proposals","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"CreateProposalRequest","response_schema":"MissionProposal","security_scheme":"workload_identity_mtls"},{"capability":"approve_proposal","method":"POST","notes":"Approves a proposal only with a valid signed decision attestation; creates the mission.","path":"/v1/mission-proposals/{proposal_id}/approve","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"ApproveProposalRequest","response_schema":"Mission","security_scheme":"workload_identity_mtls"},{"capability":"introspect_mission","method":"GET","notes":"Read-only mission status, version, and authority state.","path":"/v1/missions/{mission_ref}/introspect","reconcile_path":"","request_schema":"","response_schema":"MissionStatus","security_scheme":"workload_identity_mtls"},{"capability":"complete_mission","method":"POST","notes":"Marks a mission complete upstream; OPE still requires a locally verified receipt before presenting completion.","path":"/v1/missions/{mission_ref}/complete","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"CompleteMissionRequest","response_schema":"Mission","security_scheme":"workload_identity_mtls"},{"capability":"revoke_mission","method":"POST","notes":"Revokes a mission only with a valid signed decision attestation; must take effect at the enforcing gateway within 10 seconds.","path":"/v1/missions/{mission_ref}/revoke","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"RevokeMissionRequest","response_schema":"Revocation","security_scheme":"workload_identity_mtls"},{"capability":"list_active_missions","method":"GET","notes":"Workspace-scoped listing of active missions, including ones OPE never created locally.","path":"/v1/missions","reconcile_path":"","request_schema":"","response_schema":"ActiveMissionList","security_scheme":"workload_identity_mtls"},{"capability":"contain_workspace","method":"POST","notes":"Atomic workspace containment; only with a valid signed decision attestation.","path":"/v1/workspaces/{workspace_id}/contain","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"WorkspaceContainmentRequest","response_schema":"WorkspaceContainment","security_scheme":"workload_identity_mtls"},{"capability":"list_runtime_policies","method":"GET","notes":"Runtime policy snapshots available to the workspace.","path":"/v1/runtime-policies","reconcile_path":"","request_schema":"","response_schema":"RuntimePolicyList","security_scheme":"workload_identity_mtls"},{"capability":"compile_runtime_policy","method":"POST","notes":"Compiles the effective governed runtime policy for a mission (isolated worktree, clean home, gateway-only egress).","path":"/v1/runtime-policies/compile","reconcile_path":"","request_schema":"CompileRuntimePolicyRequest","response_schema":"RuntimePolicyManifest","security_scheme":"workload_identity_mtls"},{"capability":"create_mission_lease","method":"POST","notes":"Reserves an execution lease for a mission.","path":"/v1/missions/{mission_ref}/leases","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"CreateLeaseRequest","response_schema":"Lease","security_scheme":"workload_identity_mtls"},{"capability":"refresh_lease","method":"POST","notes":"Refreshes a lease before expiry.","path":"/v1/leases/{lease_id}/refresh","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"RefreshLeaseRequest","response_schema":"Lease","security_scheme":"workload_identity_mtls"},{"capability":"list_agent_kits","method":"GET","notes":"Supported coding-agent kits and their runtime requirements.","path":"/v1/agent-kits","reconcile_path":"","request_schema":"","response_schema":"AgentKitList","security_scheme":"workload_identity_mtls"},{"capability":"prepare_launch","method":"POST","notes":"Exactly-once preparation of a governed run: returns isolated-launch artifacts with credential delivery by anonymous file descriptor. Only with a valid signed decision attestation.","path":"/v1/missions/{mission_ref}/launch/prepare","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"PrepareLaunchRequest","response_schema":"LaunchArtifacts","security_scheme":"workload_identity_mtls"},{"capability":"begin_github_binding","method":"POST","notes":"Starts the AuthScope-hosted GitHub App installation handoff; returns the handoff id and AuthScope-origin installation URL only.","path":"/v1/integrations/github/bindings/begin","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"GitHubBindingBeginRequest","response_schema":"GitHubBindingHandoff","security_scheme":"workload_identity_mtls"},{"capability":"finish_github_binding","method":"POST","notes":"Exchanges the one-use opaque binding code for a repository binding. OPE never sees GitHub OAuth material.","path":"/v1/integrations/github/bindings/finish","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"GitHubBindingFinishRequest","response_schema":"RepositoryBinding","security_scheme":"workload_identity_mtls"},{"capability":"get_repository_binding","method":"GET","notes":"Reads a repository binding by id (immutable installation and repository ids).","path":"/v1/integrations/github/bindings/{binding_id}","reconcile_path":"","request_schema":"","response_schema":"RepositoryBinding","security_scheme":"workload_identity_mtls"},{"capability":"read_github_issue","method":"POST","notes":"Typed, server-brokered issue snapshot with provider-derived source revision and canonical source digest. No GitHub credential is returned.","path":"/v1/integrations/github/issues/snapshot","reconcile_path":"","request_schema":"GitHubIssueSnapshotRequest","response_schema":"GitHubIssueSnapshot","security_scheme":"workload_identity_mtls"},{"capability":"inspect_workflow_posture","method":"POST","notes":"Inspects workflow files, token permissions, and environments for agent-reachable secrets, write tokens, spending, or deployment authority.","path":"/v1/integrations/github/workflow-posture","reconcile_path":"","request_schema":"WorkflowPostureRequest","response_schema":"WorkflowPosture","security_scheme":"workload_identity_mtls"},{"capability":"publish_github_check","method":"POST","notes":"Idempotent check-run publication bound to immutable repository id and head SHA.","path":"/v1/integrations/github/check-runs","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"GitHubCheckRequest","response_schema":"GitHubCheckResult","security_scheme":"workload_identity_mtls"},{"capability":"list_expansions","method":"GET","notes":"Expansions for a mission; at most one open expansion is allowed by the v1 template.","path":"/v1/expansion-requests","reconcile_path":"","request_schema":"","response_schema":"ExpansionList","security_scheme":"workload_identity_mtls"},{"capability":"request_expansion","method":"POST","notes":"Creates an exact bounded expansion request for founder decision.","path":"/v1/missions/{mission_ref}/expansion-requests","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"ExpansionRequestRequest","response_schema":"ExpansionRequest","security_scheme":"workload_identity_mtls"},{"capability":"decide_expansion","method":"POST","notes":"Approves or denies an expansion only with a valid action-bound signed decision attestation.","path":"/v1/expansion-requests/{expansion_id}/approve","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"ExpansionDecision","response_schema":"ExpansionResult","security_scheme":"workload_identity_mtls"},{"capability":"consume_execution","method":"POST","notes":"Consumes from an execution grant; idempotent.","path":"/v1/executions/{grant_id}/consume","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"ConsumeExecutionRequest","response_schema":"ExecutionGrant","security_scheme":"workload_identity_mtls"},{"capability":"settle_execution","method":"POST","notes":"Settles execution after the run; idempotent.","path":"/v1/executions/settle","reconcile_path":"GET /v1/operations/{idempotency_key}","request_schema":"SettleExecutionRequest","response_schema":"ExecutionSettlement","security_scheme":"workload_identity_mtls"},{"capability":"reconcile_execution","method":"POST","notes":"Resolves uncertain execution outcomes.","path":"/v1/executions/reconcile","reconcile_path":"","request_schema":"ReconcileExecutionRequest","response_schema":"ExecutionGrant","security_scheme":"workload_identity_mtls"},{"capability":"get_receipt","method":"GET","notes":"Signed execution receipt for local verification.","path":"/v1/executions/{grant_id}/receipt","reconcile_path":"","request_schema":"","response_schema":"SignedReceipt","security_scheme":"workload_identity_mtls"},{"capability":"get_signing_keys","method":"GET","notes":"Authenticated signing-key history so OPE can verify receipts locally against a pinned root.","path":"/.well-known/auth-scope-signing-keys","reconcile_path":"","request_schema":"","response_schema":"SigningKeyHistory","security_scheme":"none"},{"capability":"read_events","method":"GET","notes":"Authenticated, cursor-resumable event page for a mission.","path":"/v1/events","reconcile_path":"","request_schema":"","response_schema":"EventPage","security_scheme":"workload_identity_mtls"},{"capability":"stream_events","method":"GET","notes":"Authenticated event stream with resumable cursor.","path":"/v1/events/stream","reconcile_path":"","request_schema":"","response_schema":"EventStream","security_scheme":"workload_identity_mtls"},{"capability":"reconcile_operation","method":"GET","notes":"Looks up the settled result of an ambiguous mutation by workspace-qualified idempotency key. Required for every mutating operation above.","path":"/v1/operations/{idempotency_key}","reconcile_path":"","request_schema":"","response_schema":"OperationResult","security_scheme":"workload_identity_mtls"},{"capability":"gateway_authorize","method":"POST","notes":"Enforcing-gateway authorization check; must reflect mission and descendant revocation immediately.","path":"/v1/gateway/authorize","reconcile_path":"","request_schema":"GatewayAuthorizeRequest","response_schema":"GatewayDecision","security_scheme":"workload_identity_mtls"}],"template_id":"github-issue-pr-v1"}